# Amazon Creators API (旧PA-API 5.0の後継) の認証情報。
# 取得方法: Amazon アソシエイトセントラル > Tools > Creators API で
# アプリケーションを作成し、Credential ID / Credential Secret を発行する。
# 直近30日間で10件以上の適格販売実績がないと発行・利用ができない場合がある。
AMAZON_CREATOR_API_ID=amzn1.application-oa2-client.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AMAZON_CREATOR_API_SECRET=amzn1.oa2-cs.v1.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# APIバージョン。3.1=api.amazon.com(US) / 3.2=api.amazon.co.uk(UK) / 3.3=api.amazon.co.jp(JP)
AMAZON_CREATOR_API_VERSION=3.3

# Amazonアソシエイト(アフィリエイト)ID
AMAZON_TAG="your-tag-22"

# マーケットプレイス国コード(参考情報。APIには www.amazon.co.jp のホスト名で渡す)
AMAZON_COUNTRY=JP
